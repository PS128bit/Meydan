<?xml version="1.0" encoding="utf-8"?>
<!-- Booking request card on Requests: player, ground, slot, price, message, Decline / Accept.
     For accepted or declined requests the buttons are hidden and txtReqStatus is shown. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtReqInitials"
                style="@style/Widget.Meydan.Avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:textSize="16sp"
                tools:text="HK" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtReqName"
                    style="@style/Text.Meydan.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Hamza Khan" />

                <TextView
                    android:id="@+id/txtReqVenue"
                    style="@style/Text.Meydan.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="12sp"
                    tools:text="Kickoff Futsal Arena" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtReqAgo"
                style="@style/Text.Meydan.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"
                tools:text="5m" />
        </LinearLayout>

        <!-- Slot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_12"
            android:backgroundTint="@color/mist"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/txtReqDate"
                style="@style/Text.Meydan.Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                tools:text="Fri 13 Nov" />

            <TextView
                android:id="@+id/txtReqTime"
                style="@style/Text.Meydan.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:textSize="14sp"
                tools:text="7:00 – 9:00 PM" />

            <TextView
                android:id="@+id/txtReqPrice"
                style="@style/Text.Meydan.PricePill"
                tools:text="Rs 8,000" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtReqMessage"
            style="@style/Text.Meydan.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_medium"
            tools:text="“Group of 10, could you keep bibs ready?”" />

        <LinearLayout
            android:id="@+id/layoutReqActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReqDecline"
                style="@style/Widget.Meydan.Button.Light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:text="@string/owner_decline"
                android:textSize="14sp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReqAccept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1.8"
                android:minHeight="44dp"
                android:text="@string/owner_accept"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconSize="18dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtReqStatus"
            style="@style/Text.Meydan.Badge.Confirmed"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:text="Accepted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
