<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist">

    <LinearLayout
        android:id="@+id/ownerBookingDarkHeader"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_owner_booking_header"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnOwnerBookingBack" style="@style/Widget.Meydan.RoundIcon.OnDark" android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="Back" android:src="@drawable/ic_back" android:padding="7dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="Booking request" android:textColor="@color/white" android:textSize="11sp" android:fontFamily="@font/inter_semibold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_owner_avatar_large" android:gravity="center" android:text="HK" android:textColor="@color/mint_dark" android:textSize="12sp" android:fontFamily="@font/inter_semibold"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hamza Khan" android:textColor="@color/white" android:textSize="15sp" android:fontFamily="@font/bricolage_bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="On Meydan since 2025 · 3 bookings" android:textColor="@color/slate_light" android:textSize="9sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="♙  His number is shared once you accept." android:textColor="@color/slate_light" android:textSize="9sp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/ownerBookingDetailScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ownerBookingActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="110dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FRI 13 NOV · 2 HOURS" android:textColor="@color/slate" android:textSize="8sp" android:fontFamily="@font/inter_semibold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_owner_price" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Rs 8,000" android:textColor="@color/obsidian" android:textSize="9sp" android:fontFamily="@font/inter_semibold"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="7:00 – 9:00 PM" android:textColor="@color/obsidian" android:textSize="20sp" android:fontFamily="@font/space_grotesk_bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Paid to you at the venue" android:textColor="@color/slate" android:textSize="9sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="15dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_free"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_busy"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_busy"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_free"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_busy"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_busy"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_peak"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_free"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_free"/>
                        <View android:layout_width="0dp" android:layout_height="15dp" android:layout_marginStart="2dp" android:layout_weight="1" android:background="@drawable/bg_owner_slot_free"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="4 PM" android:textColor="@color/slate" android:textSize="8sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9 AM" android:textColor="@color/slate" android:textSize="8sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="✓  Fits your day. No clash with other bookings." android:textColor="@color/mint_dark" android:textSize="9sp" android:fontFamily="@font/inter_semibold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Text.Meydan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Hamza says"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_owner_message" android:padding="11dp" android:text="Hi! We're a group of 10 for a friendly match. Could you keep bibs ready for us?" android:textColor="@color/obsidian" android:textSize="10sp" android:lineSpacingMultiplier="1.2"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_owner_warning" android:gravity="center_vertical" android:orientation="horizontal" android:padding="9dp">
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_info" app:tint="@color/yellow_dark"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="Accepting blocks 7–9 PM on Fri 13 Nov. Other players will see it as taken." android:textColor="@color/yellow_dark" android:textSize="9sp" android:lineSpacingMultiplier="1.1"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ownerBookingActions"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOwnerBookingDecline"
            style="@style/Widget.Meydan.Button.Outline.Danger"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Decline"
            android:textSize="11sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOwnerBookingAccept"
            style="@style/Widget.Meydan.Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="2.1"
            android:text="Accept request"
            android:textSize="11sp"
            app:icon="@drawable/ic_check"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
