<?xml version="1.0" encoding="utf-8"?>
<!-- One step in a booking status timeline (dot + connecting line + text).
     Used on Request sent and Booking details. Done steps get a mint dot in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgStepDot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/mint"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:src="@drawable/ic_check" />

        <View
            android:id="@+id/viewStepLine"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@color/mist_2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/txtStepTitle"
            style="@style/Text.Meydan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            tools:text="Request sent" />

        <TextView
            android:id="@+id/txtStepTime"
            style="@style/Text.Meydan.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Thu 21 Nov, 6:12 PM" />
    </LinearLayout>
</LinearLayout>
