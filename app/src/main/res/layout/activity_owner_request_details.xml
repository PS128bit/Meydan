<?xml version="1.0" encoding="utf-8"?>
<!-- 22 Request details: player, slot, "Fits your day" strip, message, heads-up, Decline / Accept -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist"
    android:orientation="vertical"
    tools:context=".ui.owner.OwnerRequestDetailsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- ===== Dark header ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_header">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-30dp"
                    android:layout_marginEnd="-90dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/art_header_rings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingBottom="52dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnBack"
                            style="@style/Widget.Meydan.RoundIcon.OnDark"
                            android:contentDescription="@string/back"
                            android:src="@drawable/ic_back" />

                        <TextView
                            style="@style/Text.Meydan.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="@string/owner_booking_request"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtPlayerInitials"
                            style="@style/Widget.Meydan.Avatar"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:backgroundTint="@color/mint"
                            android:textColor="@color/obsidian"
                            android:textSize="24sp"
                            tools:text="HK" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtPlayerName"
                                style="@style/Text.Meydan.Headline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                tools:text="Hamza Khan" />

                            <TextView
                                android:id="@+id/txtPlayerMeta"
                                style="@style/Text.Meydan.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/slate_light"
                                tools:text="On Meydan since 2025 · 3 bookings" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtNumberNote"
                        style="@style/Text.Meydan.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/slate_light"
                        app:drawableStartCompat="@drawable/ic_lock"
                        app:drawableTint="@color/slate_light"
                        tools:text="His number is shared once you accept." />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== Slot card (overlaps the header) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="@dimen/screen_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtSlotDay"
                            style="@style/Text.Meydan.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="Fri 13 Nov · 2 hours" />

                        <TextView
                            android:id="@+id/txtSlotPrice"
                            style="@style/Text.Meydan.PricePill"
                            android:textSize="14sp"
                            tools:text="Rs 8,000" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtSlotTime"
                        style="@style/Text.Meydan.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="28sp"
                        tools:text="7:00 – 9:00 PM" />

                    <TextView
                        style="@style/Text.Meydan.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/owner_paid_at_venue" />

                    <!-- Fits your day: evening hours 4 PM – 3 AM.
                         Dark = already booked, mint = this request, yellow = another pending request. -->
                    <LinearLayout
                        android:id="@+id/layoutDayFit"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <View style="@style/Widget.Meydan.FitBlock" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/obsidian" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/obsidian" />
                        <View style="@style/Widget.Meydan.FitBlock" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/vault_yellow" />
                        <View style="@style/Widget.Meydan.FitBlock" />
                        <View style="@style/Widget.Meydan.FitBlock" />
                        <View style="@style/Widget.Meydan.FitBlock" />
                        <View style="@style/Widget.Meydan.FitBlock" android:layout_marginEnd="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/space_grotesk_bold"
                            android:text="@string/owner_fit_start"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk_bold"
                            android:text="@string/owner_fit_end"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtFitsDay"
                        style="@style/Text.Meydan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center_vertical"
                        android:text="@string/owner_fits_day"
                        android:textColor="@color/mint_dark"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_check"
                        app:drawableTint="@color/mint_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Message ===== -->
            <TextView
                android:id="@+id/txtMessageLabel"
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="24dp"
                tools:text="Hamza says" />

            <TextView
                android:id="@+id/txtMessage"
                style="@style/Text.Meydan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/screen_margin"
                android:background="@drawable/bg_bubble"
                android:lineSpacingMultiplier="1.2"
                android:padding="16dp"
                android:textSize="14sp"
                tools:text="Hi! We're a group of 10 for a friendly match. Could you keep bibs ready for us?" />

            <!-- ===== Heads up ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/screen_margin"
                android:background="@drawable/bg_rounded_16"
                android:backgroundTint="@color/yellow_tint"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/yellow_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtHeadsUp"
                        style="@style/Text.Meydan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/yellow_dark"
                        android:textSize="13sp"
                        tools:text="Accepting blocks 7–9 PM on Fri 13 Nov." />

                    <TextView
                        style="@style/Text.Meydan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/owner_heads_up_2"
                        android:textColor="@color/yellow_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Actions ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDecline"
            style="@style/Widget.Meydan.Button.Outline.Danger"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:text="@string/owner_decline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/owner_accept_request"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
