<?xml version="1.0" encoding="utf-8"?>
<!-- 17 Owner home: this week's bookings, occupancy chart, quick stats, requests waiting for an answer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist"
    tools:context=".ui.owner.OwnerHomeActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/nav_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Dark header ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_header">

                <ImageView
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="-110dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/art_header_rings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingBottom="26dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtOwnerGreeting"
                            style="@style/Text.Meydan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/slate_light"
                            tools:text="Good evening, Usman" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <ImageButton
                                android:id="@+id/btnOwnerNotifications"
                                style="@style/Widget.Meydan.RoundIcon.OnDark"
                                android:contentDescription="@string/nav_alerts"
                                android:src="@drawable/ic_bell" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="9dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/vault_yellow" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Meydan.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/owner_this_week"
                        android:textColor="@color/slate_light" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtSlotsBooked"
                            style="@style/Text.Meydan.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/mint"
                            android:textSize="38sp"
                            tools:text="38" />

                        <TextView
                            style="@style/Text.Meydan.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/owner_slots_booked"
                            android:textColor="@color/white"
                            android:textSize="38sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtOccupancy"
                        style="@style/Text.Meydan.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/slate_light"
                        tools:text="Kickoff Futsal Arena · 72% of hours filled" />

                    <!-- Occupancy chart: filled share of each day. Today (Thursday) is yellow. -->
                    <LinearLayout
                        android:id="@+id/layoutOccupancyChart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="-4dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/Widget.Meydan.Chart.Column">
                            <FrameLayout style="@style/Widget.Meydan.Chart.Track">
                                <View style="@style/Widget.Meydan.Chart.Bar" android:layout_height="57dp" />
                            </FrameLayout>
                            <TextView style="@style/Widget.Meydan.Chart.Day" android:text="@string/day_m" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.Meydan.Chart.Column">
                            <FrameLayout style="@style/Widget.Meydan.Chart.Track">
                                <View style="@style/Widget.Meydan.Chart.Bar" android:layout_height="64dp" />
                            </FrameLayout>
                            <TextView style="@style/Widget.Meydan.Chart.Day" android:text="@string/day_t" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.Meydan.Chart.Column">
                            <FrameLayout style="@style/Widget.Meydan.Chart.Track">
                                <View style="@style/Widget.Meydan.Chart.Bar" android:layout_height="50dp" />
                            </FrameLayout>
                            <TextView style="@style/Widget.Meydan.Chart.Day" android:text="@string/day_w" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.Meydan.Chart.Column">
                            <FrameLayout style="@style/Widget.Meydan.Chart.Track">
                                <View
                                    style="@style/Widget.Meydan.Chart.Bar"
                                    android:layout_height="83dp"
                                    android:backgroundTint="@color/vault_yellow" />
                            </FrameLayout>
                            <TextView
                                style="@style/Widget.Meydan.Chart.Day"
                                android:text="@string/day_t"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.Meydan.Chart.Column">
                            <FrameLayout style="@style/Widget.Meydan.Chart.Track">
                                <View style="@style/Widget.Meydan.Chart.Bar" android:layout_height="96dp" />
                            </FrameLayout>
                            <TextView style="@style/Widget.Meydan.Chart.Day" android:text="@string/day_f" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.Meydan.Chart.Column">
                            <FrameLayout style="@style/Widget.Meydan.Chart.Track">
                                <View style="@style/Widget.Meydan.Chart.Bar" android:layout_height="104dp" />
                            </FrameLayout>
                            <TextView style="@style/Widget.Meydan.Chart.Day" android:text="@string/day_s" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.Meydan.Chart.Column">
                            <FrameLayout style="@style/Widget.Meydan.Chart.Track">
                                <View style="@style/Widget.Meydan.Chart.Bar" android:layout_height="73dp" />
                            </FrameLayout>
                            <TextView style="@style/Widget.Meydan.Chart.Day" android:text="@string/day_s" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick stats -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/pillNewRequests"
                                style="@style/Widget.Meydan.StatPill"
                                android:backgroundTint="@color/vault_yellow"
                                android:textColor="@color/obsidian"
                                app:drawableStartCompat="@drawable/ic_bolt"
                                app:drawableTint="@color/obsidian"
                                tools:text="4 new requests" />

                            <TextView
                                android:id="@+id/pillToday"
                                style="@style/Widget.Meydan.StatPill"
                                app:drawableStartCompat="@drawable/ic_calendar"
                                app:drawableTint="@color/mint"
                                tools:text="3 today" />

                            <TextView
                                android:id="@+id/pillRating"
                                style="@style/Widget.Meydan.StatPill"
                                app:drawableStartCompat="@drawable/ic_star"
                                app:drawableTint="@color/vault_yellow"
                                tools:text="4.8 rating" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </FrameLayout>

            <!-- ===== Needs your answer ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin">

                <TextView
                    style="@style/Text.Meydan.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/owner_needs_answer"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/txtSeeAllRequests"
                    style="@style/Text.Meydan.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="See all 4" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOwnerHomeRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_owner_request_compact" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_owner_nav" />
</FrameLayout>
