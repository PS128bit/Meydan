<?xml version="1.0" encoding="utf-8"?>
<!-- One alert. Icon colour and the action button change by type in code
     (accepted = mint + "See ticket", declined = red, reminder = yellow, rate = "Rate now"). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgAlertIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/mint_tint"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_check"
            app:tint="@color/mint_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtAlertTitle"
                    style="@style/Text.Meydan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="14sp"
                    tools:text="Ali Raza accepted your request" />

                <TextView
                    android:id="@+id/txtAlertTime"
                    style="@style/Text.Meydan.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:textSize="12sp"
                    tools:text="2m" />

                <View
                    android:id="@+id/dotAlertUnread"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/mint_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtAlertBody"
                style="@style/Text.Meydan.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                tools:text="Sat 23 Nov · 8 – 10 PM at Kickoff Futsal Arena. You can now call the owner." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlertAction"
                style="@style/Widget.Meydan.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                tools:text="See ticket"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
