<?xml version="1.0" encoding="utf-8"?>
<!-- 18 Add ground, step 1: sport, name, location, description, facilities -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.owner.AddGroundDetailsActivity">

    <!-- Step header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Meydan.RoundIcon"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Text.Meydan.Badge"
                android:backgroundTint="@color/mist"
                android:fontFamily="@font/space_grotesk_bold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/owner_step_1"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <View style="@style/Widget.Meydan.StepBar.Done" />
            <View style="@style/Widget.Meydan.StepBar" android:layout_marginStart="6dp" />
            <View style="@style/Widget.Meydan.StepBar" android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Text.Meydan.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/owner_add1_title_1"
                android:textSize="30sp" />

            <TextView
                style="@style/Text.Meydan.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_highlight"
                android:paddingStart="2dp"
                android:paddingEnd="4dp"
                android:text="@string/owner_add1_title_2"
                android:textSize="30sp" />

            <!-- Sport picker -->
            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filter_sport" />

            <LinearLayout
                android:id="@+id/groupSportPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pickFutsal"
                    style="@style/Widget.Meydan.SportPick"
                    app:cardBackgroundColor="@color/obsidian">

                    <ImageView
                        android:id="@+id/imgPickFutsal"
                        style="@style/Widget.Meydan.SportPickCourt"
                        android:src="@drawable/court_futsal" />

                    <TextView
                        android:id="@+id/txtPickFutsal"
                        style="@style/Widget.Meydan.SportPickName"
                        android:text="@string/sport_futsal"
                        android:textColor="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pickCricket"
                    style="@style/Widget.Meydan.SportPick"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/imgPickCricket"
                        style="@style/Widget.Meydan.SportPickCourt"
                        android:alpha="0.45"
                        android:src="@drawable/court_cricket"
                        app:tint="@color/obsidian" />

                    <TextView
                        android:id="@+id/txtPickCricket"
                        style="@style/Widget.Meydan.SportPickName"
                        android:text="@string/sport_cricket" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pickPadel"
                    style="@style/Widget.Meydan.SportPick"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/imgPickPadel"
                        style="@style/Widget.Meydan.SportPickCourt"
                        android:alpha="0.45"
                        android:src="@drawable/court_padel"
                        app:tint="@color/obsidian" />

                    <TextView
                        android:id="@+id/txtPickPadel"
                        style="@style/Widget.Meydan.SportPickName"
                        android:text="@string/sport_padel" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pickMore"
                    style="@style/Widget.Meydan.SportPick"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_plus" />

                    <TextView
                        style="@style/Widget.Meydan.SportPickName"
                        android:text="@string/owner_more" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Ground name -->
            <TextView
                style="@style/Text.Meydan.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:labelFor="@id/etGroundName"
                android:text="@string/owner_ground_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGroundName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGroundName"
                    style="@style/Widget.Meydan.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/owner_ground_name_hint"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Meydan.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/etLocation"
                    android:text="@string/owner_location" />

                <TextView
                    android:id="@+id/txtPickOnMap"
                    style="@style/Text.Meydan.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_pick_on_map"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_pin">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLocation"
                    style="@style/Widget.Meydan.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/owner_location_hint"
                    android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Description -->
            <TextView
                style="@style/Text.Meydan.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etDescription"
                android:text="@string/owner_description" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    style="@style/Widget.Meydan.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/owner_description_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Facilities -->
            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/facilities" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupOwnerFacilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/facility_floodlights" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/facility_parking" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/facility_changing" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/owner_facility_water" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_facility_washrooms" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_facility_cafe" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextPhotos"
            style="@style/Widget.Meydan.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/owner_next_photos"
            app:icon="@drawable/ic_arrow_right" />
    </LinearLayout>
</LinearLayout>
