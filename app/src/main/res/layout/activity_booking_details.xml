<?xml version="1.0" encoding="utf-8"?>
<!-- 12 Booking details: status card, timeline, owner contact (after confirmation), location, payment -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist"
    android:orientation="vertical"
    tools:context=".ui.player.BookingDetailsActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Meydan.RoundIcon.OnPhoto"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Meydan.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/booking_title" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/Widget.Meydan.RoundIcon.OnPhoto"
            android:contentDescription="@string/cd_more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="24dp">

            <!-- Status card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Meydan.Card.Dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="94dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="-20dp"
                        android:layout_marginBottom="-10dp"
                        android:alpha="0.25"
                        android:importantForAccessibility="no"
                        android:src="@drawable/court_futsal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/txtBookingStatus"
                            style="@style/Text.Meydan.Badge"
                            android:backgroundTint="@color/mint"
                            android:textColor="@color/obsidian"
                            tools:text="Confirmed" />

                        <TextView
                            android:id="@+id/txtBookingDate"
                            style="@style/Text.Meydan.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/white"
                            tools:text="Sat, 23 Nov" />

                        <TextView
                            android:id="@+id/txtBookingTime"
                            style="@style/Text.Meydan.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/mint"
                            android:textSize="22sp"
                            tools:text="8:00 – 10:00 PM" />

                        <TextView
                            android:id="@+id/txtBookingVenue"
                            style="@style/Text.Meydan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/white"
                            tools:text="Kickoff Futsal Arena" />

                        <TextView
                            android:id="@+id/txtBookingCourt"
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/slate_light"
                            tools:text="Court 2 · 10 players · Booking #MD-2318" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Timeline -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/Text.Meydan.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/booking_progress" />

                    <include
                        android:id="@+id/stepRequested"
                        layout="@layout/item_timeline_step" />

                    <include
                        android:id="@+id/stepAccepted"
                        layout="@layout/item_timeline_step" />

                    <include
                        android:id="@+id/stepMatchDay"
                        layout="@layout/item_timeline_step" />

                    <include
                        android:id="@+id/stepRate"
                        layout="@layout/item_timeline_step" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Owner contact: unlocked once the owner confirms -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtOwnerInitials"
                        style="@style/Widget.Meydan.Avatar"
                        tools:text="AR" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtOwnerName"
                            style="@style/Text.Meydan.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Ali Raza" />

                        <TextView
                            android:id="@+id/txtOwnerPhone"
                            style="@style/Text.Meydan.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/slate"
                            android:textSize="14sp"
                            tools:text="+92 300 7654321" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnMessageOwner"
                        style="@style/Widget.Meydan.RoundIcon"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/cd_message_owner"
                        android:src="@drawable/ic_message" />

                    <ImageButton
                        android:id="@+id/btnCallOwner"
                        style="@style/Widget.Meydan.RoundIcon"
                        android:backgroundTint="@color/mint"
                        android:contentDescription="@string/cd_call_owner"
                        android:src="@drawable/ic_phone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_rounded_12"
                        android:backgroundTint="@color/mint_tint"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/mint_dark" />

                    <TextView
                        android:id="@+id/txtBookingAddress"
                        style="@style/Text.Meydan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        tools:text="Street 7, F-11 Markaz, Islamabad" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDirections"
                        style="@style/Widget.Meydan.Button.Light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/directions"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_navigate"
                        app:iconGravity="textStart"
                        app:iconSize="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/Widget.Meydan.SummaryRow">

                        <TextView
                            android:id="@+id/txtBookingRate"
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            tools:text="2 hours × Rs 3,000" />

                        <TextView
                            android:id="@+id/txtBookingTotal"
                            style="@style/Text.Meydan.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Rs 6,000" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Meydan.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/pay_at_ground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelBooking"
                style="@style/Widget.Meydan.Button.Outline.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/cancel_booking" />

            <TextView
                style="@style/Text.Meydan.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/cancel_note"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
