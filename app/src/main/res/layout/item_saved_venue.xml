<?xml version="1.0" encoding="utf-8"?>
<!-- Saved ground tile (2-column grid on Saved grounds) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="118dp">

            <ImageView
                android:id="@+id/imgSaved"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_photo"
                android:contentDescription="@string/cd_venue_photo"
                android:padding="18dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/court_padel" />

            <ImageButton
                android:id="@+id/btnUnsave"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/cd_unsave"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart_filled"
                android:tint="@color/red" />

            <TextView
                android:id="@+id/txtSavedSport"
                style="@style/Text.Meydan.Badge"
                android:layout_gravity="start|bottom"
                android:layout_margin="8dp"
                android:backgroundTint="@color/vault_yellow"
                android:textColor="@color/obsidian"
                android:textSize="10sp"
                tools:text="PADEL" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtSavedName"
            style="@style/Text.Meydan.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="4dp"
            android:textSize="15sp"
            tools:text="Smash Padel Club" />

        <TextView
            android:id="@+id/txtSavedArea"
            style="@style/Text.Meydan.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            tools:text="E-11/2 · 3.4 km" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSavedPrice"
                style="@style/Text.Meydan.Number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                tools:text="Rs 4,000" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star"
                app:tint="@color/vault_yellow" />

            <TextView
                android:id="@+id/txtSavedRating"
                style="@style/Text.Meydan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/inter_semibold"
                android:textSize="13sp"
                tools:text="4.7" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
