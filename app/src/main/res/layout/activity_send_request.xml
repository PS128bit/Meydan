<?xml version="1.0" encoding="utf-8"?>
<!-- 09 Send request: booking summary, players, message to the owner -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist"
    android:orientation="vertical"
    tools:context=".ui.player.SendRequestActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Meydan.RoundIcon.OnPhoto"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Meydan.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/send_request_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="24dp">

            <!-- Summary card (receipt style) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_photo"
                            android:contentDescription="@string/cd_venue_photo"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/court_futsal" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtReqVenue"
                                style="@style/Text.Meydan.CardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="Kickoff Futsal Arena" />

                            <TextView
                                android:id="@+id/txtReqCourt"
                                style="@style/Text.Meydan.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Futsal · Court 2 · F-11 Markaz" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <LinearLayout style="@style/Widget.Meydan.SummaryRow">

                        <TextView
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/summary_date"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtReqDate"
                            style="@style/Text.Meydan.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            tools:text="Sat, 23 Nov" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.Meydan.SummaryRow">

                        <TextView
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/summary_time"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtReqTime"
                            style="@style/Text.Meydan.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            tools:text="8:00 – 10:00 PM" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.Meydan.SummaryRow">

                        <TextView
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/summary_rate"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtReqRate"
                            style="@style/Text.Meydan.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            tools:text="2 × Rs 3,000" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.Meydan.Divider"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        style="@style/Widget.Meydan.SummaryRow"
                        android:layout_marginTop="12dp">

                        <TextView
                            style="@style/Text.Meydan.Subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/summary_total" />

                        <TextView
                            android:id="@+id/txtReqTotal"
                            style="@style/Text.Meydan.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            tools:text="Rs 6,000" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Players -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Meydan.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/players" />

                        <TextView
                            style="@style/Text.Meydan.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/players_hint" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnPlayersMinus"
                        style="@style/Widget.Meydan.RoundIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="9dp"
                        android:contentDescription="@string/cd_fewer_players"
                        android:src="@drawable/ic_minus" />

                    <TextView
                        android:id="@+id/txtPlayers"
                        style="@style/Text.Meydan.Number"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        tools:text="10" />

                    <ImageButton
                        android:id="@+id/btnPlayersPlus"
                        style="@style/Widget.Meydan.RoundIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/obsidian"
                        android:padding="9dp"
                        android:tint="@color/white"
                        android:contentDescription="@string/cd_more_players"
                        android:src="@drawable/ic_plus" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Message to owner -->
            <TextView
                style="@style/Text.Meydan.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etMessage"
                android:text="@string/message_owner" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@color/white"
                app:counterEnabled="true"
                app:counterMaxLength="200">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMessage"
                    style="@style/Widget.Meydan.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/message_owner_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- How it works -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_16"
                android:backgroundTint="@color/mint_tint"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cash"
                    app:tint="@color/mint_dark" />

                <TextView
                    style="@style/Text.Meydan.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/request_pay_note"
                    android:textColor="@color/obsidian" />
            </LinearLayout>

            <TextView
                style="@style/Text.Meydan.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/request_offline_note"
                app:drawableStartCompat="@drawable/ic_sync"
                app:drawableTint="@color/slate" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/send_request_button"
            app:icon="@drawable/ic_arrow_right" />
    </LinearLayout>
</LinearLayout>
