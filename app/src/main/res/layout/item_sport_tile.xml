<?xml version="1.0" encoding="utf-8"?>
<!-- Sport tile in the "Pick your game" row on Home -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="128dp"
    android:layout_height="140dp"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgSportCourt"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_rounded_12"
            android:backgroundTint="@color/obsidian"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/court_futsal" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtSportName"
            style="@style/Text.Meydan.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            tools:text="Futsal" />

        <TextView
            android:id="@+id/txtSportCount"
            style="@style/Text.Meydan.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="24 grounds" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
