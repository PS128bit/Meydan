<?xml version="1.0" encoding="utf-8"?>
<!-- Picked photo thumbnail with a remove button (Rate your game) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="84dp"
    android:layout_height="84dp"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/imgThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_photo"
        android:contentDescription="@string/cd_review_photo"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/court_futsal" />

    <ImageButton
        android:id="@+id/btnRemovePhoto"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/cd_remove_photo"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />
</FrameLayout>
