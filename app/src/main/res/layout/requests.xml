<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist">

    <LinearLayout
        android:id="@+id/ownerRequestsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/Text.Meydan.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requests"
                android:textSize="20sp"/>
            <TextView
                android:id="@+id/tvOwnerNewRequestCount"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_owner_request_count"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="● 4 new"
                android:textColor="@color/yellow_dark"
                android:textSize="9sp"
                android:fontFamily="@font/inter_semibold"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/ownerRequestTabs"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabOwnerPending"
                style="@style/Widget.Meydan.OwnerTab"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:checked="true"
                android:text="Pending"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabOwnerAccepted"
                style="@style/Widget.Meydan.OwnerTab"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="Accepted"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabOwnerDeclined"
                style="@style/Widget.Meydan.OwnerTab"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="Declined"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <ScrollView
        android:id="@+id/ownerRequestsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/ownerRequestsHeader"
        app:layout_constraintBottom_toTopOf="@id/ownerBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/ownerRequestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_owner_request_hamza"/>
            <include layout="@layout/item_owner_request_bilal"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOwnerRequestSara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="25dp" android:layout_height="25dp" android:background="@drawable/bg_owner_avatar" android:gravity="center" android:text="SM" android:textColor="@color/mint_dark" android:textSize="9sp" android:fontFamily="@font/inter_semibold"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sara Malik" android:textColor="@color/obsidian" android:textSize="11sp" android:fontFamily="@font/inter_semibold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kickoff Futsal Arena" android:textColor="@color/slate" android:textSize="8sp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1h" android:textColor="@color/slate" android:textSize="8sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="27dp" android:layout_marginTop="5dp" android:background="@drawable/bg_owner_request_date" android:gravity="center_vertical" android:paddingStart="7dp" android:paddingEnd="7dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sun 15 Nov  5:00 – 6:00 PM" android:textColor="@color/obsidian" android:textSize="9sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_owner_price" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="Rs 4,000" android:textColor="@color/obsidian" android:textSize="8sp" android:fontFamily="@font/inter_semibold"/>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="“Can we bring our own ball?”" android:textColor="@color/slate" android:textSize="9sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="25dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <TextView android:id="@+id/btnOwnerDeclineSara" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_owner_decline" android:gravity="center" android:text="Decline" android:textColor="@color/obsidian" android:textSize="9sp" android:fontFamily="@font/inter_semibold"/>
                        <TextView android:id="@+id/btnOwnerAcceptSara" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1.4" android:background="@drawable/bg_owner_accept" android:gravity="center" android:text="✓  Accept" android:textColor="@color/obsidian" android:textSize="9sp" android:fontFamily="@font/inter_semibold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/ownerBottomNavigation"
        layout="@layout/view_owner_nav"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
