<?xml version="1.0" encoding="utf-8"?>
<!-- 24-hour opening bar: closed (mist) / open (mint). Weights = hours.
     Reused on Ground details and Add ground step 3. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutDayBar"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/mist_2"
        android:orientation="horizontal">

        <View
            android:id="@+id/barClosedMorning"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6" />

        <View
            android:id="@+id/barOpen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="17"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/mint" />

        <View
            android:id="@+id/barClosedNight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Meydan.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_medium"
            android:text="@string/hour_12am"
            android:textSize="11sp" />

        <TextView
            style="@style/Text.Meydan.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_medium"
            android:gravity="center"
            android:text="@string/hour_6am"
            android:textSize="11sp" />

        <TextView
            style="@style/Text.Meydan.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_medium"
            android:gravity="center"
            android:text="@string/hour_12pm"
            android:textSize="11sp" />

        <TextView
            style="@style/Text.Meydan.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_medium"
            android:gravity="center"
            android:text="@string/hour_6pm"
            android:textSize="11sp" />

        <TextView
            style="@style/Text.Meydan.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_medium"
            android:gravity="end"
            android:text="@string/hour_12am"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
