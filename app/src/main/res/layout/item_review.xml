<?xml version="1.0" encoding="utf-8"?>
<!-- Review row on Ground details -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_stroke"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtReviewerInitials"
            style="@style/Widget.Meydan.Avatar.Small"
            tools:text="UA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtReviewerName"
                style="@style/Text.Meydan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textSize="14sp"
                tools:text="Umair A." />

            <TextView
                android:id="@+id/txtReviewDate"
                style="@style/Text.Meydan.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text="Played 2 weeks ago" />
        </LinearLayout>

        <RatingBar
            android:id="@+id/ratingReview"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:isIndicator="true"
            android:numStars="5"
            android:progressBackgroundTint="@color/mist_2"
            android:progressTint="@color/vault_yellow"
            android:rating="5"
            android:stepSize="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtReviewBody"
        style="@style/Text.Meydan.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        tools:text="Turf is in great shape and the lights are bright. Ali replied within ten minutes." />
</LinearLayout>
