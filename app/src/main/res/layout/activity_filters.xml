<?xml version="1.0" encoding="utf-8"?>
<!-- 06 Filters: sport, price range with histogram, day and time, distance, facilities -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.player.FiltersActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnClose"
            style="@style/Widget.Meydan.RoundIcon"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />

        <TextView
            style="@style/Text.Meydan.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/filters" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Meydan.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="24dp">

            <!-- Sport -->
            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/filter_sport" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/sport_futsal" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_cricket" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/sport_padel" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_squash" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_table_tennis" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_swimming" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_halls" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_workshops" />
            </com.google.android.material.chip.ChipGroup>

            <View
                style="@style/Widget.Meydan.Divider"
                android:layout_marginTop="22dp" />

            <!-- Price per hour -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Meydan.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_price" />

                <TextView
                    android:id="@+id/txtPriceRange"
                    style="@style/Text.Meydan.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="Rs 1,500 – 4,500" />
            </LinearLayout>

            <!-- Price histogram: how many grounds sit at each price -->
            <LinearLayout
                android:id="@+id/layoutHistogram"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View style="@style/Widget.Meydan.HistoBar.Off" android:layout_height="12dp" />
                <View style="@style/Widget.Meydan.HistoBar.Off" android:layout_height="22dp" />
                <View style="@style/Widget.Meydan.HistoBar" android:layout_height="30dp" />
                <View style="@style/Widget.Meydan.HistoBar" android:layout_height="44dp" />
                <View style="@style/Widget.Meydan.HistoBar" android:layout_height="56dp" />
                <View style="@style/Widget.Meydan.HistoBar" android:layout_height="48dp" />
                <View style="@style/Widget.Meydan.HistoBar" android:layout_height="38dp" />
                <View style="@style/Widget.Meydan.HistoBar" android:layout_height="40dp" />
                <View style="@style/Widget.Meydan.HistoBar" android:layout_height="26dp" />
                <View style="@style/Widget.Meydan.HistoBar.Off" android:layout_height="18dp" />
                <View style="@style/Widget.Meydan.HistoBar.Off" android:layout_height="20dp" />
                <View style="@style/Widget.Meydan.HistoBar.Off" android:layout_height="10dp" />
                <View style="@style/Widget.Meydan.HistoBar.Off" android:layout_height="8dp" />
                <View style="@style/Widget.Meydan.HistoBar.Off" android:layout_height="6dp" />
            </LinearLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/sliderPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/filter_price"
                android:stepSize="100"
                android:valueFrom="500"
                android:valueTo="6000"
                app:labelBehavior="gone"
                app:thumbColor="@color/obsidian"
                app:trackColorActive="@color/mint"
                app:trackColorInactive="@color/mist_2"
                app:values="@array/filter_price_default" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Meydan.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_price_min" />

                <TextView
                    style="@style/Text.Meydan.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_price_max" />
            </LinearLayout>

            <View
                style="@style/Widget.Meydan.Divider"
                android:layout_marginTop="22dp" />

            <!-- When -->
            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/filter_when" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/today" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tomorrow" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/this_weekend" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_date"
                    app:chipIcon="@drawable/ic_calendar"
                    app:chipIconSize="18dp" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_morning" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_afternoon" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/time_evening" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Meydan.Chip.Mist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_night" />
            </com.google.android.material.chip.ChipGroup>

            <View
                style="@style/Widget.Meydan.Divider"
                android:layout_marginTop="22dp" />

            <!-- Distance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Meydan.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_distance" />

                <TextView
                    android:id="@+id/txtDistance"
                    style="@style/Text.Meydan.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="Within 5 km" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/filter_distance"
                android:stepSize="1"
                android:value="5"
                android:valueFrom="1"
                android:valueTo="25"
                app:labelBehavior="gone"
                app:thumbColor="@color/obsidian"
                app:trackColorActive="@color/mint"
                app:trackColorInactive="@color/mist_2" />

            <View
                style="@style/Widget.Meydan.Divider"
                android:layout_marginTop="14dp" />

            <!-- Facilities -->
            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/filter_facilities" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbParking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="@string/facility_parking"
                android:textSize="15sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbFloodlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/facility_floodlights"
                android:textSize="15sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbChanging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/facility_changing"
                android:textSize="15sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbWater"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/facility_water"
                android:textSize="15sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbIndoor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/facility_indoor"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowResults"
            style="@style/Widget.Meydan.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Show 12 grounds" />
    </LinearLayout>
</LinearLayout>
