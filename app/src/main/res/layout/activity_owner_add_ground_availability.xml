<?xml version="1.0" encoding="utf-8"?>
<!-- 20 Add ground, step 3: open days, hours, slot length, blocked dates, preview, publish -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.owner.AddGroundAvailabilityActivity">

    <!-- Step header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Meydan.RoundIcon"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Text.Meydan.Badge"
                android:backgroundTint="@color/mist"
                android:fontFamily="@font/space_grotesk_bold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/owner_step_3"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <View style="@style/Widget.Meydan.StepBar.Done" />
            <View style="@style/Widget.Meydan.StepBar.Done" android:layout_marginStart="6dp" />
            <View style="@style/Widget.Meydan.StepBar.Done" android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Text.Meydan.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/owner_add3_title_1"
                android:textSize="30sp" />

            <TextView
                style="@style/Text.Meydan.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_highlight_yellow"
                android:paddingStart="2dp"
                android:paddingEnd="4dp"
                android:text="@string/owner_add3_title_2"
                android:textSize="30sp" />

            <!-- Open days: tap a circle to turn a day on or off -->
            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/owner_open_days" />

            <LinearLayout
                android:id="@+id/groupOpenDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <CheckBox android:id="@+id/dayMon" style="@style/Widget.Meydan.DayToggle" android:checked="true" android:text="@string/day_m" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <CheckBox android:id="@+id/dayTue" style="@style/Widget.Meydan.DayToggle" android:checked="true" android:text="@string/day_t" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <CheckBox android:id="@+id/dayWed" style="@style/Widget.Meydan.DayToggle" android:checked="true" android:text="@string/day_w" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <CheckBox android:id="@+id/dayThu" style="@style/Widget.Meydan.DayToggle" android:checked="true" android:text="@string/day_t" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <CheckBox android:id="@+id/dayFri" style="@style/Widget.Meydan.DayToggle" android:checked="true" android:text="@string/day_f" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <CheckBox android:id="@+id/daySat" style="@style/Widget.Meydan.DayToggle" android:checked="true" android:text="@string/day_s" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <CheckBox android:id="@+id/daySun" style="@style/Widget.Meydan.DayToggle" android:text="@string/day_s" />
            </LinearLayout>

            <!-- Hours: open 4 PM to 3 AM, shown on a 24-hour bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Meydan.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/owner_hours" />

                <TextView
                    android:id="@+id/txtHoursRange"
                    style="@style/Text.Meydan.Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    tools:text="4:00 PM – 3:00 AM" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHoursBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_16"
                android:backgroundTint="@color/mist"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:background="@drawable/bg_rounded_16"
                    android:backgroundTint="@color/mint" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rounded_4"
                    android:backgroundTint="@color/obsidian" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="13" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rounded_4"
                    android:backgroundTint="@color/obsidian" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="8"
                    android:background="@drawable/bg_rounded_16"
                    android:backgroundTint="@color/mint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView style="@style/Widget.Meydan.HourTick" android:gravity="start" android:text="@string/owner_tick_12a" />
                <TextView style="@style/Widget.Meydan.HourTick" android:text="@string/owner_tick_6a" />
                <TextView style="@style/Widget.Meydan.HourTick" android:text="@string/owner_tick_12p" />
                <TextView style="@style/Widget.Meydan.HourTick" android:text="@string/owner_tick_6p" />
                <TextView style="@style/Widget.Meydan.HourTick" android:gravity="end" android:text="@string/owner_tick_12a" />
            </LinearLayout>

            <!-- Slot length -->
            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/owner_slot_length" />

            <RadioGroup
                android:id="@+id/segSlotLength"
                style="@style/Widget.Meydan.SegmentTrack"
                android:layout_marginTop="10dp"
                android:checkedButton="@+id/segOneHour">

                <RadioButton
                    android:id="@+id/segHalfHour"
                    style="@style/Widget.Meydan.Segment"
                    android:text="@string/owner_len_30" />

                <RadioButton
                    android:id="@+id/segOneHour"
                    style="@style/Widget.Meydan.Segment"
                    android:text="@string/owner_len_60" />

                <RadioButton
                    android:id="@+id/segTwoHours"
                    style="@style/Widget.Meydan.Segment"
                    android:text="@string/owner_len_120" />
            </RadioGroup>

            <!-- Blocked dates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Meydan.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/owner_blocked_dates" />

                <TextView
                    android:id="@+id/btnAddBlockedDate"
                    style="@style/Text.Meydan.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_add_date"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowBlockedDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rounded_16"
                android:backgroundTint="@color/mist"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/txtBlockedDate"
                    style="@style/Text.Meydan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="14sp"
                    tools:text="Fri 20 Nov · Private event" />

                <ImageButton
                    android:id="@+id/btnRemoveBlockedDate"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/owner_remove_date"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="@color/slate" />
            </LinearLayout>

            <!-- Preview -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Meydan.Card.Dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/Text.Meydan.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/owner_players_will_see"
                        android:textColor="@color/slate_light" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtSlotsPerDay"
                            style="@style/Text.Meydan.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/mint"
                            tools:text="11" />

                        <TextView
                            android:id="@+id/txtSlotsPerDayLabel"
                            style="@style/Text.Meydan.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="2dp"
                            android:textColor="@color/white"
                            tools:text="slots a day, Mon – Sat" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:alpha="0.55" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:alpha="0.55" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:alpha="0.55" android:backgroundTint="@color/mint" />
                        <View style="@style/Widget.Meydan.FitBlock" android:layout_marginEnd="0dp" android:alpha="0.55" android:backgroundTint="@color/mint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/owner_publish"
            app:icon="@drawable/ic_arrow_right" />
    </LinearLayout>
</LinearLayout>
