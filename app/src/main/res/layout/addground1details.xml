<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:id="@+id/ownerStep1Scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnOwnerStep1Next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnOwnerStep1Back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_owner_onboard_circle"
                    android:contentDescription="Go back"
                    android:padding="11dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/obsidian" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_owner_onboard_step"
                    android:gravity="center"
                    android:text="1 / 3"
                    android:textColor="@color/obsidian"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_semibold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_owner_onboard_progress_active" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_owner_onboard_progress_inactive" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_owner_onboard_progress_inactive" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/bricolage_extrabold"
                android:text="Tell players\nabout your ground."
                android:textColor="@color/obsidian"
                android:textSize="26sp"
                android:lineSpacingMultiplier="0.96" />

            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Sport" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tileSportFutsal"
                        android:layout_width="64dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_owner_sport_selected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="38dp"
                            android:contentDescription="Futsal court"
                            android:src="@drawable/court_futsal" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Futsal"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileSportCricket"
                        android:layout_width="64dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_owner_sport_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="38dp"
                            android:contentDescription="Cricket ground"
                            android:src="@drawable/court_cricket" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cricket"
                            android:textColor="@color/obsidian"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileSportPadel"
                        android:layout_width="64dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_owner_sport_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="38dp"
                            android:contentDescription="Padel court"
                            android:src="@drawable/court_padel" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Padel"
                            android:textColor="@color/obsidian"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileSportMore"
                        android:layout_width="64dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_owner_sport_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_plus"
                            android:contentDescription="More sports"
                            app:tint="@color/obsidian" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="More"
                            android:textColor="@color/obsidian"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                style="@style/Text.Meydan.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ground name" />

            <EditText
                android:id="@+id/etOwnerGroundName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_owner_onboard_field"
                android:hint="e.g. Kickoff Futsal Arena"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/obsidian"
                android:textColorHint="@color/slate"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/Text.Meydan.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Location" />
                <TextView
                    android:id="@+id/tvOwnerPickOnMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick on map"
                    android:textColor="@color/mint_dark"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_semibold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_owner_onboard_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/slate" />
                <EditText
                    android:id="@+id/etOwnerGroundLocation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Enter ground address"
                    android:inputType="textCapSentences"
                    android:singleLine="true"
                    android:textColor="@color/obsidian"
                    android:textColorHint="@color/slate"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/Text.Meydan.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Description" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:background="@drawable/bg_owner_onboard_field">
                <EditText
                    android:id="@+id/etOwnerGroundDescription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="Describe your ground, facilities and opening hours."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="18dp"
                    android:textColor="@color/obsidian"
                    android:textColorHint="@color/slate"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvOwnerDescriptionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="7dp"
                    android:text="0 / 500"
                    android:textColor="@color/slate"
                    android:textSize="10sp" />
            </FrameLayout>

            <TextView
                style="@style/Text.Meydan.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Facilities" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupOwnerFacilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:singleLine="false"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFloodlights"
                    style="@style/Widget.Meydan.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:checked="true"
                    android:text="Floodlights" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipParking"
                    style="@style/Widget.Meydan.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:checked="true"
                    android:text="Parking" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipChangingRooms"
                    style="@style/Widget.Meydan.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:checked="true"
                    android:text="Changing rooms" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWater"
                    style="@style/Widget.Meydan.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:checked="true"
                    android:text="Water" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWashrooms"
                    style="@style/Widget.Meydan.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Washrooms" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCafe"
                    style="@style/Widget.Meydan.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Cafe" />
            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOwnerStep1Next"
        style="@style/Widget.Meydan.Button"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="Next: photos and price"
        app:icon="@drawable/ic_arrow_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
