<?xml version="1.0" encoding="utf-8"?>
<!-- Schedule row: confirmed booking (dark). Taller for 2-hour bookings: set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txtSlotTime"
        android:layout_width="56dp"
        android:layout_height="52dp"
        android:fontFamily="@font/space_grotesk_bold"
        android:gravity="center_vertical"
        android:textColor="@color/obsidian"
        android:textSize="13sp"
        tools:text="5 PM" />

    <LinearLayout
        android:id="@+id/cardSlot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_rounded_16"
        android:backgroundTint="@color/obsidian"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSlotWho"
                style="@style/Text.Meydan.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="Ali Raza" />

            <TextView
                android:id="@+id/txtSlotStatus"
                style="@style/Text.Meydan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/mint"
                android:textSize="12sp"
                tools:text="Confirmed" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSlotLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_bold"
            android:textColor="@color/slate_light"
            android:textSize="12sp"
            tools:text="1 hr" />
    </LinearLayout>
</LinearLayout>
